rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'hofong159@gmail.com' ||
        (request.auth.token.email is string &&
          exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email)))
      );
    }

    function isPublicCode(code) {
      return code.matches('^[a-f0-9]{32}$');
    }

    match /settings/{settingId} {
      allow get: if settingId == 'public' || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /schedule/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminUsers/{email} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && email.matches('^[^/]+@[^/]+$')
        && request.resource.data.email == email;
      allow delete: if isAdmin() && email != 'hofong159@gmail.com';
    }

    match /bookings/{code} {
      allow get: if isAdmin() || isPublicCode(code);
      allow list: if isAdmin();

      allow create: if isAdmin() || (isPublicCode(code)
        && request.resource.data.keys().hasAll([
          'name','className','phone','borrowType','type','itemId','item',
          'date','start','hours','purpose','status','startAt','endAt',
          'endDate','endTime','lockIds','photoIds','createdAt',
          'checkedInAt','checkedOutAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name','className','phone','borrowType','type','itemId','item',
          'date','start','hours','purpose','status','startAt','endAt',
          'endDate','endTime','lockIds','photoIds','createdAt',
          'checkedInAt','checkedOutAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.className is string
        && request.resource.data.phone is string
        && request.resource.data.itemId is string
        && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.available == true
        && (
          get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.category == request.resource.data.type ||
          get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.category == 'all'
        )
        && get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.name == request.resource.data.item
        && request.resource.data.date is string
        && request.resource.data.start is string
        && request.resource.data.hours in [3,6]
        && request.resource.data.status == 'pending'
        && request.resource.data.lockIds is list
        && request.resource.data.lockIds.size() in [6,12]
        && request.resource.data.photoIds is list
        && request.resource.data.photoIds.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.checkedInAt == null
        && request.resource.data.checkedOutAt == null);

      allow update: if isAdmin() ||
        (
          isPublicCode(code) &&
          resource.data.status == 'approved' &&
          resource.data.checkedInAt == null &&
          resource.data.checkedOutAt == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedInAt']) &&
          request.resource.data.checkedInAt == request.time
        ) ||
        (
          isPublicCode(code) &&
          resource.data.status == 'approved' &&
          resource.data.checkedInAt != null &&
          resource.data.checkedOutAt == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedOutAt','photoIds']) &&
          request.resource.data.checkedOutAt == request.time &&
          request.resource.data.photoIds is list &&
          request.resource.data.photoIds.size() <= 5
        );

      allow delete: if isAdmin();

      match /photos/{photoId} {
        allow get, list: if isAdmin();
        allow create: if isAdmin() || (
          isPublicCode(code)
          && request.resource.data.keys().hasOnly(['dataUrl','name','contentType','createdAt','importedLegacyPhoto'])
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() < 700000
          && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,.*$')
          && request.resource.data.contentType == 'image/jpeg'
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/bookings/$(code)).data.status == 'approved'
          && get(/databases/$(database)/documents/bookings/$(code)).data.checkedInAt != null
          && get(/databases/$(database)/documents/bookings/$(code)).data.checkedOutAt == null
        );
        allow update, delete: if isAdmin();
      }
    }

    match /reservationLocks/{lockId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || (request.resource.data.keys().hasAll([
          'bookingId','lockId','itemId','date','time','lane','status','createdAt'
        ])
        && request.resource.data.lockId == lockId
        && isPublicCode(request.resource.data.bookingId)
        && request.resource.data.lane in [0,1]
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.itemId == request.resource.data.itemId
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.lockIds.hasAny([lockId]));
      allow update, delete: if isAdmin();
    }
  }
}
