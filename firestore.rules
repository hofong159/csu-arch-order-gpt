rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    // Students do not sign in. Public pages can only read published settings,
    // available items and course schedule. Public booking writes go through
    // Cloud Functions, which uses the Admin SDK to validate requests and locks.
    match /settings/{id} {
      allow read: if id == 'public';
      allow write: if isAdmin();
    }
    match /items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /schedule/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bookings/{id} {
      allow read, create, update, delete: if isAdmin();
    }
    match /reservationLocks/{id} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
