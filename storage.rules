rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.uid in ['REPLACE_WITH_ADMIN_UID'];
    }
    match /checkoutPhotos/{ownerUid}/{bookingId}/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == ownerUid);
      allow write: if signedIn()
        && request.auth.uid == ownerUid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == ownerUid);
    }
  }
}
