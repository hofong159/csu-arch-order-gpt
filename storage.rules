rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    // Student photo uploads use short-lived server-generated signed URLs.
    // Regular Firebase Storage SDK requests are admin-only.
    match /checkoutPhotos/{bookingId}/{fileName} {
      allow read, write, delete: if isAdmin();
    }
  }
}
